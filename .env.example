# The Docker till uses the host network, so 127.0.0.1 is the VPS itself.
# Runtime pool should eventually connect as platform_app (after roles are provisioned).
DATABASE_URL=postgres://chaska:chaska@127.0.0.1:5433/chaska_pos
# Admin/migration pool (table owner). Defaults to DATABASE_URL when unset.
DATABASE_ADMIN_URL=postgres://chaska:chaska@127.0.0.1:5433/chaska_pos
# Optional password for provisioning the platform_app role on first boot.
# PLATFORM_APP_PASSWORD=change-me
API_ADDR=127.0.0.1:8787
