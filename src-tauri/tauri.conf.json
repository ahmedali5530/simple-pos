{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shop",
  "version": "0.1.0",
  "identifier": "com.shop.till",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:8788",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shop",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
